# Copy the API section to api/.env and the WEB section to web/.env.local.
# Real keys stay empty here and are never committed. The dev-only values below are throwaway.

# ---------- API (api/.env) ----------
PORT=4000
NODE_ENV=development
# Browser origin allowed to call the API (web site URL). Comma separated for more than one.
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string. Leave empty in development to use a temporary in-memory database.
MONGODB_URI=

# Long random strings, different from each other. Empty in development = random per run.
CUSTOMER_JWT_SECRET=
ADMIN_JWT_SECRET=

# Cloudinary (Round 4/5)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test keys first). Empty = a fake local payment id is used in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Login: "account" (default) = email + password accounts; guest checkout always works.
# "guest" = no Sign in at all (guest checkout only).
# "otp" = old phone code sign in, switched off by default (needs the OTP settings below; MSG91 approval takes about a week).
LOGIN_MODE=account
# Web address used in password reset emails. Leave empty to use the first CORS_ORIGIN.
WEB_URL=

# New-order email to the family. MAIL_PROVIDER=log prints the email in the console (development).
# MAIL_PROVIDER=smtp sends it for real; then fill in the SMTP values (any provider, e.g. your email host's SMTP details).
OWNER_EMAIL=
MAIL_PROVIDER=log
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OTP: "test" uses the fixed code below and sends no SMS. "live" uses SMS_PROVIDER (msg91).
# The server refuses to start in production with OTP_MODE=test.
OTP_MODE=test
OTP_TEST_CODE=123456
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Seed script: first admin account. Development-only test login; change it for any real database.
SEED_ADMIN_EMAIL=owner@rajufishes.test
SEED_ADMIN_PASSWORD=dev-admin-pass-123
# Optional second login with the staff role, for trying the role limits. Development only.
SEED_STAFF_EMAIL=staff@rajufishes.test
SEED_STAFF_PASSWORD=dev-staff-pass-123

# ---------- WEB (web/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public key id only. The secret never goes in web.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Analytics reports for the owner-only Analytics page in the admin (see docs/ANALYTICS.md).
# GA4_PROPERTY_ID is the number from GA4 > Admin > Property details.
# GA_SERVICE_ACCOUNT_JSON_BASE64 is the service-account key file, base64-encoded onto one line. Never commit the real value.
GA4_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON_BASE64=

# Firebase / Google Analytics for the shop pages (web/.env.local). Leave empty and the shop simply does not track.
# Set NEXT_PUBLIC_ANALYTICS_DEV=1 to test tracking while running locally.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_DEV=
