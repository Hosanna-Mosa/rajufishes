# Copy the API section to api/.env and the WEB section to web/.env.local.
# Keep every value empty here. Never commit real keys.

# ---------- API (api/.env) ----------
PORT=4000
NODE_ENV=development
# Browser origin allowed to call the API (web site URL)
CORS_ORIGIN=

# MongoDB Atlas connection string
MONGODB_URI=

# Long random strings, different from each other
CUSTOMER_JWT_SECRET=
ADMIN_JWT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OTP: "test" uses the fixed code below and sends no SMS. "live" uses SMS_PROVIDER.
OTP_MODE=
OTP_TEST_CODE=
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Seed script: first admin account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- WEB (web/.env.local) ----------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
# Public key id only. The secret never goes in web.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
